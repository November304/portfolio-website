---
import "../../styles/global.css";
import Header from '../../components/Header.astro';
import Footer from "../../components/Footer.astro";

import cityImage from '../../assets/img/city.jpg';
import imagePP from '../../assets/img/mecrandom.jpg';
import { Image } from 'astro:assets';

import { getCollection } from "astro:content";
import { getLangFromUrl } from "../../i18n/utils"
import ProjectCard from "../../components/generic/ProjectCard.astro";

const lang = getLangFromUrl(Astro.url);
const formations = await getCollection("formations", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});
const experiences = await getCollection("experiences", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});

const volunteering = await getCollection("volunteering", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});

const projects = await getCollection("blog", (entry) => {
  return entry.data.lang == lang;
});

---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portfolio website</title>
</head>
<body class="bg-white text-gray-900">
    <Header />
    
    <main>
        
        <section id="home" class="min-h-screen flex flex-col items-center justify-center pt-20 relative">
            <div class="text-center flex-1 flex flex-col justify-center">
                <h1 class="text-5xl font-bold mb-4">Nathan Pagnucco</h1>
                <p class="text-xl text-gray-600">Developer | DevOps | Game Dev</p>
                <div class="absolute inset-0 z-[-1]">
                    <Image src={cityImage} alt="City background" class="w-full h-full object-cover opacity-20" loading="eager"/>
                </div>
                <div class="mt-8">
                    <a href="#projects" class="bg-blue-500 text-white px-6 py-3 rounded-full hover:bg-blue-600 transition">
                        Discover My Projects
                    </a>
                </div>
            </div>
            <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
                <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </div>
        </section>

        <section id="home" class="bg-gray-100 py-20">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Home</h2>
                <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8">
                    <div class="flex flex-col items-center">
                        <Image 
                            src={imagePP} 
                            alt="Profile of Nathan Pagnucco" 
                            class="rounded-lg shadow-md w-48 h-auto sm:w-64 md:w-72"
                        />
                        <p class="mt-4 font-semibold">Email:</p>
                        <a 
                            href="mailto:nathan.pagnucco@gmail.com" 
                            class="text-blue-500 hover:underline"
                        >
                            nathan.pagnucco@gmail.com
                        </a>
                        <a 
                            href="/portfolio-website/CVNP-en.pdf" 
                            download 
                            class="mt-2 px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
                        >
                            Download My CV
                        </a>
                        
                        <div class="flex gap-3 mt-4">
                            <a 
                                href="https://www.linkedin.com/in/nathan-pagnucco-53b7ab265/" 
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex items-center gap-2 px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-800 transition"
                                title="LinkedIn"
                            >
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                                LinkedIn
                            </a>
                            <a 
                                href="https://github.com/November304" 
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex items-center gap-2 px-4 py-2 bg-gray-800 text-white rounded hover:bg-gray-900 transition"
                                title="GitHub"
                            >
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                GitHub
                            </a>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold mb-4">Why Me?</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            I am currently an engineering student at ENSEEIHT in an apprenticeship program at Sopra Steria. This format allows me to combine academic training with concrete professional experience.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            In parallel with my studies, I actively participate in the school's student life: Vice-President of the newspaper, member of net7 (the computer science association), and Vice-President of a list. These commitments allow me to develop my communication, project management, and teamwork skills.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            Passionate about video game development, I regularly create prototypes with Unity, which allows me to explore my creativity while perfecting my technical skills.
                        </p>
                    </div>
                </div>
                
                <!-- Password-protected section -->
                <div class="mt-12 max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-md">
                    <h3 class="text-2xl font-bold mb-4 text-center">Protected Area</h3>
                    <div id="protected-section" class="text-center">
                        <p class="text-gray-600 mb-4">This section contains the elevator pitch and interviews. Please enter the password to access it.</p>
                        <input 
                            type="password" 
                            id="password-input" 
                            placeholder="Password"
                            class="px-4 py-2 border border-gray-300 rounded mb-4 w-64"
                        />
                        <button 
                            id="unlock-btn"
                            class="px-6 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 ml-2"
                        >
                            Unlock
                        </button>
                        <p id="error-msg" class="text-red-500 mt-2 hidden">Incorrect password</p>
                    </div>
                    <div id="protected-content" class="hidden">
                        <div class="mb-6">
                            <h4 class="text-xl font-semibold mb-3">Elevator Pitch</h4>
                            <div class="flex justify-center rounded-lg overflow-hidden shadow-md">
                                <iframe 
                                    width="100%" 
                                    height="315" 
                                    src="https://www.youtube.com/embed/YYhO1xniIws" 
                                    title="Elevator Pitch"
                                    frameborder="0" 
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                    allowfullscreen
                                >
                                </iframe>
                            </div>
                        </div>
                        <div>
                            <h4 class="text-xl font-semibold mb-3">Professional Interviews</h4>
                            <p class="text-gray-700 text-justify mb-4">
                                I had the opportunity to interview three professionals with different backgrounds. These exchanges helped me understand that the professional world is mainly composed of opportunities and that career paths are never linear.
                            </p>
                            
                            <div class="space-y-4">
                                <div class="bg-gray-50 p-4 rounded-lg">
                                    <h5 class="font-semibold text-lg mb-2">Jérémy C. - IT Manager</h5>
                                    <p class="text-sm text-gray-600 italic mb-2">*The individual requested not to disclose personal information</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Education:</strong> Engineering studies at CNAM</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Current position:</strong> IT Manager in a small company</p>
                                    <p class="text-sm text-gray-700"><strong>Role:</strong> Software development, database administration, technology watch, and management of a team of 4 developers</p>
                                </div>Responsibilities
                                
                                <div class="bg-gray-50 p-4 rounded-lg">
                                    <h5 class="font-semibold text-lg mb-2">Philippe Oulie - Lead Developer</h5>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Education:</strong> DUT in Statistics</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Career path:</strong> Thanks to a recruitment opportunity, he started as a COBOL developer at INFORSUD, a company acquired by Sopra Steria in 2003</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Current position:</strong> Lead Developer at Sopra Steria</p>
                                    <p class="text-sm text-gray-700"><strong>Role:</strong> Expert in COBOL and associated technologies, he has deep knowledge of the client and their needs. He mentors and guides other developers on the team through his extensive experience.</p>
                                </div>
                                
                                <div class="bg-gray-50 p-4 rounded-lg">
                                    <h5 class="font-semibold text-lg mb-2">Nabil Hanine - Enterprise Architect</h5>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Education:</strong> Master's degree in MIAGE</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Career path:</strong> Started as a project manager at CIRSO</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Evolution:</strong> Became an enterprise architect in 2017</p>
                                    <p class="text-sm text-gray-700"><strong>Role:</strong> Designs and oversees the overall architecture of the company's information systems. He defines technical standards, ensures consistency across different systems, and leads the organization's digital transformation.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section id="engineering" class="py-20 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Engineering Course</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-gray-50 p-8 rounded-lg shadow-md">
                        <h3 class="text-2xl font-bold mb-4">ENSEEIHT - Digital Sciences</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            I am currently a student in the engineering program at ENSEEIHT (École Nationale Supérieure d'Électrotechnique, d'Électronique, d'Informatique, d'Hydraulique et des Télécommunications) in Digital Sciences. This program covers a broad spectrum of skills in computer science and telecommunications, with a particular focus on two major areas:
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mb-4 space-y-2">
                            <li><strong>Networks and Telecommunications:</strong> Network architecture, communication protocols, distributed system security, and modern telecommunications infrastructures.</li>
                            <li><strong>Software Development:</strong> Development methodologies, software architecture, databases, artificial intelligence, and web and mobile technologies.</li>
                        </ul>
                        
                        <h4 class="text-xl font-semibold mb-3 mt-6">Student Association Involvement</h4>
                        <p class="text-gray-700 mb-4 text-justify">
                            Beyond my studies, I actively participate in the school's student life through several roles:
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mb-4 space-y-3">
                            <li><strong>Vice-President of a list:</strong> Lists are two groups of first-year students competing by organizing events to join the second-year student association in various offices (Student Bureau, Arts Bureau, Student Lounge, etc.). This role allows me to develop my event organization and teamwork skills.</li>
                            <li><strong>Vice-President of the school newspaper:</strong> This responsibility allows me to improve my writing skills and develop my questioning abilities through interviews I conduct with students, professors, and professionals.</li>
                            <li><strong>Member of net7 (computer science association):</strong> I work on concrete IT projects such as creating websites and dashboards for other associations and clubs at the school, which allows me to apply my technical skills to serve the community.</li>
                        </ul>
                        <p class="text-gray-700 text-justify">
                            These responsibilities allow me to develop my project management, communication, teamwork, and leadership skills while actively contributing to the school's student life.
                        </p>
                    </div>
                    
                    <div class="mt-8 max-w-4xl mx-auto text-center">
                        <p class="text-gray-700 text-lg">
                            Here's an overview of my professional and academic journey that has brought me here.
                        </p>
                    </div>
                    
                    <div class="mt-8 grid md:grid-cols-2 gap-6">
                        <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-500">
                            <h4 class="text-xl font-semibold mb-3">Professional Experiences</h4>
                            <div class="space-y-4">
                                {experiences
                                    .sort((a, b) => new Date(b.data.period.split(" - ")[1] || new Date().toISOString()).getTime() - new Date(a.data.period.split(" - ")[1] || new Date().toISOString()).getTime())
                                    .map((exp) => (
                                    <div>
                                        <p class="font-semibold">{exp.data.title}</p>
                                        <p class="text-sm text-gray-600 mb-2">{exp.data.company} | {exp.data.period}</p>
                                        {exp.data.actions && exp.data.actions.length > 0 && (
                                            <ul class="text-sm text-gray-700 list-disc list-inside space-y-1">
                                                {exp.data.actions.map((action) => (
                                                    <li>{action}</li>
                                                ))}
                                            </ul>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                        
                        <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-green-500">
                            <h4 class="text-xl font-semibold mb-3">Education</h4>
                            <div class="space-y-4">
                                {formations
                                    .sort((a, b) => new Date(b.data.period.split(" - ")[1] || new Date().toISOString()).getTime() - new Date(a.data.period.split(" - ")[1] || new Date().toISOString()).getTime())
                                    .map((formation) => (
                                    <div>
                                        <p class="font-semibold">{formation.data.title}</p>
                                        <p class="text-sm text-gray-600 mb-2">{formation.data.school} | {formation.data.period}</p>
                                        {formation.data.description && (
                                            <p class="text-sm text-gray-700">{formation.data.description}</p>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section id="csr" class="py-20 bg-gray-50">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">CSR Engagement</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-white p-8 rounded-lg shadow-md mb-8">
                        <h3 class="text-2xl font-bold mb-4">My Commitment</h3>
                        <p class="text-gray-700 text-justify">
                            Civic and environmental engagement is something that is particularly important to me. I have already participated in several volunteer activities and I intend to continue investing in initiatives that have a positive impact on society and the environment.
                        </p>
                    </div>
                    
                    <div class="space-y-6">
                        {volunteering
                            .sort((a, b) => new Date(b.data.date || new Date().toISOString()).getTime() - new Date(a.data.date || new Date().toISOString()).getTime())
                            .map((vol) => (
                            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-purple-500">
                                <div class="flex flex-col md:flex-row gap-6">
                                    <div class="flex-shrink-0 flex justify-center items-center md:w-1/3">
                                        <Image src={vol.data.image} alt={vol.data.title} width={400} height={300} class="rounded shadow-md object-cover"/>
                                    </div>
                                    <div class="md:w-2/3 flex flex-col justify-center">
                                        <h4 class="text-2xl font-semibold mb-3">{vol.data.title}</h4>
                                        <p class="text-gray-700 text-justify text-lg">
                                            {vol.data.description}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>
        
        <section id="international" class="py-20 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">International</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-gray-50 p-8 rounded-lg shadow-md mb-8">
                        <h3 class="text-2xl font-bold mb-4">An International Project</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            As part of the engineering curriculum at ENSEEIHT, I must complete an experience abroad, which particularly interests me. I wish to go to an English-speaking country to perfect my English, discover new pedagogical approaches, and immerse myself in a different culture.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            This international experience will also allow me to expand my professional network and enrich my academic journey with global perspectives, while developing my adaptability in a multicultural environment.
                        </p>
                    </div>
                    
                    <div class="bg-white p-8 rounded-lg shadow-md mb-8 border-l-4 border-blue-500">
                        <h3 class="text-xl font-bold mb-4">Target Universities</h3>
                        <p class="text-gray-700 mb-4">I am particularly interested in the following three universities for their courses in computer science and software engineering:</p>
                        <div class="space-y-4">
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold text-lg mb-2">🇨🇦 Concordia University - Canada</p>
                                <p class="text-sm text-gray-700"><strong>Specialty:</strong> Computer Science and Software Engineering (CSSE)</p>
                                <p class="text-sm text-gray-600 mt-1">Renowned program with a strong focus on software engineering and application development.</p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold text-lg mb-2">🇳🇴 Norges Teknisk-Naturvitenskapelige Universitet (NTNU) - Norway</p>
                                <p class="text-sm text-gray-700"><strong>Department:</strong> Department of Computer Science (IDI)</p>
                                <p class="text-sm text-gray-600 mt-1">One of Scandinavia's leading technical universities, renowned for its computer science programs.</p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold text-lg mb-2">🇦🇺 University of Sydney - Australia</p>
                                <p class="text-sm text-gray-700"><strong>Major:</strong> Computer Science</p>
                                <p class="text-sm text-gray-600 mt-1">Program focused on software engineering with a practical and innovative approach.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-green-50 p-6 rounded-lg shadow-md border-l-4 border-green-500">
                        <h4 class="text-lg font-semibold mb-3">Opportunity through Sopra Steria</h4>
                        <p class="text-gray-700 text-justify">
                            As an apprentice at Sopra Steria, I have the opportunity to go abroad with my company. Here is a summary of the communicated information (for confidentiality reasons):
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mt-3 space-y-2">
                            <li><strong>Spain:</strong> Keeping the same assignment as currently, it is very easy to join the Spanish team working on the same project.</li>
                            <li><strong>Other English-speaking countries:</strong> It is possible, but it depends on availability, openings, and the company's needs at the time of the request.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section id="projects" class="py-20">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">My Projects</h2>
                <p class="text-center text-lg mb-8">Here are some projects I've worked on during my free time or as part of my coursework.</p>
                <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                    {projects
                        // .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
                        .map((project) => (
                            <ProjectCard 
                                title={project.data.titre} 
                                description={project.data.description} 
                                link={"/portfolio-website/"+lang+"/project/" + project.id.split('/')[1].replace('.mdx', '')}
                                technologies={project.data.technologies}
                                tags={project.data.tags}
                            />
                    ))}
                </div>
            </div>
        </section>
    </main>
	<Footer />
	
	<script>
		// Script for password-protected section
		const passwordInput = document.getElementById('password-input') as HTMLInputElement;
		const unlockBtn = document.getElementById('unlock-btn') as HTMLButtonElement;
		const errorMsg = document.getElementById('error-msg') as HTMLElement;
		const protectedSection = document.getElementById('protected-section') as HTMLElement;
		const protectedContent = document.getElementById('protected-content') as HTMLElement;
		
		// Simple password - Change according to your needs
		const correctPassword = 'cam2025';
		
		unlockBtn?.addEventListener('click', () => {
			if (passwordInput?.value === correctPassword) {
				protectedSection?.classList.add('hidden');
				protectedContent?.classList.remove('hidden');
				errorMsg?.classList.add('hidden');
			} else {
				errorMsg?.classList.remove('hidden');
			}
		});
		
		passwordInput?.addEventListener('keypress', (e) => {
			if (e.key === 'Enter') {
				unlockBtn?.click();
			}
		});
	</script>
</body>
</html>