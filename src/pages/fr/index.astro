---
import "../../styles/global.css";
import Header from '../../components/Header.astro';
import Footer from "../../components/Footer.astro";

import cityImage from '../../assets/img/city.jpg';
import imagePP from '../../assets/img/mecrandom.jpg';
import { Image } from 'astro:assets';

import { getCollection } from "astro:content";
import { getLangFromUrl } from "../../i18n/utils"
import ProjectCard from "../../components/generic/ProjectCard.astro";

const lang = getLangFromUrl(Astro.url);
const formations = await getCollection("formations", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});
const experiences = await getCollection("experiences", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});

const volunteering = await getCollection("volunteering", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});

const projects = await getCollection("blog", (entry) => {
  return entry.data.lang == lang;
});


---
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Site Portfolio</title>
</head>
<body class="bg-white text-gray-900">
    <Header />
    
    <main>
        
        <section id="home" class="min-h-screen flex flex-col items-center justify-center pt-20 relative">
            <div class="text-center flex-1 flex flex-col justify-center">
                <h1 class="text-5xl font-bold mb-4">Nathan Pagnucco</h1>
                <p class="text-xl text-gray-600">Développeur | DevOps | Game Dev</p>
                <div class="absolute inset-0 z-[-1]">
                    <Image src={cityImage} alt="City background" class="w-full h-full object-cover opacity-20" loading="eager"/>
                </div>
                <div class="mt-8">
                    <a href="#projects" class="bg-blue-500 text-white px-6 py-3 rounded-full hover:bg-blue-600 transition">
                        Découvrir mes Projets
                    </a>
                </div>
            </div>
            <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
                <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </div>
        </section>

        <section id="home" class="bg-gray-100 py-20">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Accueil</h2>
                <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8">
                    <div class="flex flex-col items-center">
                        <Image 
                            src={imagePP} 
                            alt="Profil de Nathan Pagnucco" 
                            class="rounded-lg shadow-md w-48 h-auto sm:w-64 md:w-72"
                        />
                        <p class="mt-4 font-semibold">Email :</p>
                        <a 
                            href="mailto:nathan.pagnucco@gmail.com" 
                            class="text-blue-500 hover:underline"
                        >
                            nathan.pagnucco@gmail.com
                        </a>
                        <a 
                            href="/portfolio-website/CVNP-fr.pdf" 
                            download 
                            class="mt-2 px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
                        >
                            Télécharger mon CV
                        </a>
                        
                        <div class="flex gap-3 mt-4">
                            <a 
                                href="https://www.linkedin.com/in/nathan-pagnucco-53b7ab265/" 
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex items-center gap-2 px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-800 transition"
                                title="LinkedIn"
                            >
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                                LinkedIn
                            </a>
                            <a 
                                href="https://github.com/November304" 
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex items-center gap-2 px-4 py-2 bg-gray-800 text-white rounded hover:bg-gray-900 transition"
                                title="GitHub"
                            >
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                GitHub
                            </a>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold mb-4">Pourquoi moi ?</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            Je suis actuellement étudiant en cycle ingénieur à l'ENSEEIHT en alternance à Sopra Steria. Ce format me permet de combiner formation académique et expérience professionnelle concrète.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            En parallèle de mes études, je participe activement à la vie associative de l'école : Vice-président du journal, membre de net7 (l'association informatique), et Vice-président d'une liste. Ces engagements me permettent de développer mes compétences en communication, gestion de projet et travail d'équipe.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            Passionné par le développement de jeux vidéo, je développe régulièrement des prototypes avec Unity, ce qui me permet d'explorer ma créativité tout en perfectionnant mes compétences techniques.
                        </p>
                    </div>
                </div>
                
                <!-- Section protégée par mot de passe -->
                <div class="mt-12 max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-md">
                    <h3 class="text-2xl font-bold mb-4 text-center">Espace Protégé</h3>
                    <div id="protected-section" class="text-center">
                        <p class="text-gray-600 mb-4">Cette section contient l'elevator pitch et les interviews. Veuillez entrer le mot de passe pour y accéder.</p>
                        <input 
                            type="password" 
                            id="password-input" 
                            placeholder="Mot de passe"
                            class="px-4 py-2 border border-gray-300 rounded mb-4 w-64"
                        />
                        <button 
                            id="unlock-btn"
                            class="px-6 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 ml-2"
                        >
                            Déverrouiller
                        </button>
                        <p id="error-msg" class="text-red-500 mt-2 hidden">Mot de passe incorrect</p>
                    </div>
                    <div id="protected-content" class="hidden">
                        <div class="mb-6">
                            <h4 class="text-xl font-semibold mb-3">Elevator Pitch</h4>
                            <p class="text-gray-700 text-justify">
                                [Votre elevator pitch ici - à personnaliser]
                            </p>
                        </div>
                        <div>
                            <h4 class="text-xl font-semibold mb-3">Interviews Professionnelles</h4>
                            <p class="text-gray-700 text-justify mb-4">
                                J'ai eu l'opportunité d'interviewer trois professionnels aux parcours différents. Ces échanges m'ont permis de comprendre que le monde professionnel est surtout composé d'opportunités et que les parcours ne sont jamais linéaires.
                            </p>
                            
                            <div class="space-y-4">
                                <div class="bg-gray-50 p-4 rounded-lg">
                                    <h5 class="font-semibold text-lg mb-2">Jérémy C. - Responsable Informatique</h5>
                                    <p class="text-sm text-gray-600 italic mb-2">*La personne a demandé à ne pas divulguer ses informations personnelles</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Formation :</strong> Études d'ingénieur au CNAM</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Poste actuel :</strong> Responsable informatique dans une petite entreprise</p>
                                    <p class="text-sm text-gray-700"><strong>Rôle :</strong> Développement logiciel, administration de bases de données, veille technologique, et gestion d'une équipe de 4 développeurs</p>
                                </div>
                                
                                <div class="bg-gray-50 p-4 rounded-lg">
                                    <h5 class="font-semibold text-lg mb-2">Philippe Oulie - Développeur Principal</h5>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Formation :</strong> DUT en Statistiques</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Parcours :</strong> Grâce à une opportunité de recrutement, il a commencé en tant que développeur COBOL chez INFORSUD, entreprise rachetée par Sopra Steria en 2003</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Poste actuel :</strong> Développeur principal à Sopra Steria</p>
                                    <p class="text-sm text-gray-700"><strong>Rôle :</strong> Expert en COBOL et technologies associées, il connaît parfaitement le client et ses besoins. Il accompagne et guide les autres développeurs de l'équipe grâce à son expérience.</p>
                                </div>
                                
                                <div class="bg-gray-50 p-4 rounded-lg">
                                    <h5 class="font-semibold text-lg mb-2">Nabil Hanine - Architecte d'Entreprise</h5>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Formation :</strong> Master MIAGE</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Parcours :</strong> A débuté comme chef de projet au CIRSO</p>
                                    <p class="text-sm text-gray-700 mb-2"><strong>Évolution :</strong> Devenu architecte d'entreprise en 2017</p>
                                    <p class="text-sm text-gray-700"><strong>Rôle :</strong> Conçoit et supervise l'architecture globale des systèmes d'information de l'entreprise. Il définit les standards techniques, assure la cohérence entre les différents systèmes et accompagne la transformation digitale de l'organisation.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section id="engineering" class="py-20 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Parcours Ingénieur</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-gray-50 p-8 rounded-lg shadow-md">
                        <h3 class="text-2xl font-bold mb-4">ENSEEIHT - Sciences du Numérique</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            Je suis actuellement étudiant en cycle ingénieur à l'ENSEEIHT (École Nationale Supérieure d'Électrotechnique, d'Électronique, d'Informatique, d'Hydraulique et des Télécommunications) en Sciences du Numérique. Cette formation couvre un large spectre de compétences en informatique et télécommunications, avec une orientation particulière sur deux axes majeurs :
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mb-4 space-y-2">
                            <li><strong>Réseaux et Télécommunications :</strong> Architecture des réseaux, protocoles de communication, sécurité des systèmes distribués et infrastructures de télécommunications modernes.</li>
                            <li><strong>Développement logiciel :</strong> Méthodologies de développement, architecture logicielle, bases de données, intelligence artificielle et technologies web et mobile.</li>
                        </ul>
                        
                        <h4 class="text-xl font-semibold mb-3 mt-6">Engagement Associatif</h4>
                        <p class="text-gray-700 mb-4 text-justify">
                            Au-delà de mes études, je m'investis activement dans la vie associative de l'école à travers plusieurs rôles :
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mb-4 space-y-3">
                            <li><strong>Vice-président d'une liste :</strong> Les listes sont deux groupes d'étudiants de première année qui s'affrontent en organisant des événements pour intégrer l'association étudiante de deuxième année dans les différents bureaux (Bureau des Élèves, Bureau des Arts, Foyer, etc.). Ce rôle me permet de développer mes compétences en organisation d'événements et en travail d'équipe.</li>
                            <li><strong>Vice-président du journal de l'école :</strong> Cette responsabilité me permet d'améliorer mes compétences rédactionnelles et de développer mon sens du questionnement grâce aux interviews que je mène auprès d'étudiants, de professeurs et de professionnels.</li>
                            <li><strong>Membre de net7 (association informatique) :</strong> Je travaille sur des projets informatiques concrets comme la réalisation de sites web et de tableaux de bords pour les autres associations et clubs de l'école, ce qui me permet d'appliquer mes compétences techniques au service de la communauté.</li>
                        </ul>
                        <p class="text-gray-700 text-justify">
                            Ces responsabilités me permettent de développer mes compétences en gestion de projet, en communication, en travail d'équipe et en leadership, tout en contribuant activement à la vie étudiante de l'école.
                        </p>
                    </div>
                    
                    <div class="mt-8 max-w-4xl mx-auto text-center">
                        <p class="text-gray-700 text-lg">
                            Voici un aperçu de mon parcours professionnel et académique qui m'a conduit jusqu'ici.
                        </p>
                    </div>
                    
                    <div class="mt-8 grid md:grid-cols-2 gap-6">
                        <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-500">
                            <h4 class="text-xl font-semibold mb-3">Expériences Professionnelles</h4>
                            <div class="space-y-4">
                                {experiences
                                    .sort((a, b) => new Date(b.data.period.split(" - ")[1] || new Date().toISOString()).getTime() - new Date(a.data.period.split(" - ")[1] || new Date().toISOString()).getTime())
                                    .map((exp) => (
                                    <div>
                                        <p class="font-semibold">{exp.data.title}</p>
                                        <p class="text-sm text-gray-600 mb-2">{exp.data.company} | {exp.data.period}</p>
                                        {exp.data.actions && exp.data.actions.length > 0 && (
                                            <ul class="text-sm text-gray-700 list-disc list-inside space-y-1">
                                                {exp.data.actions.map((action) => (
                                                    <li>{action}</li>
                                                ))}
                                            </ul>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                        
                        <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-green-500">
                            <h4 class="text-xl font-semibold mb-3">Formations</h4>
                            <div class="space-y-4">
                                {formations
                                    .sort((a, b) => new Date(b.data.period.split(" - ")[1] || new Date().toISOString()).getTime() - new Date(a.data.period.split(" - ")[1] || new Date().toISOString()).getTime())
                                    .map((formation) => (
                                    <div>
                                        <p class="font-semibold">{formation.data.title}</p>
                                        <p class="text-sm text-gray-600 mb-2">{formation.data.school} | {formation.data.period}</p>
                                        {formation.data.description && (
                                            <p class="text-sm text-gray-700">{formation.data.description}</p>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section id="csr" class="py-20 bg-gray-50">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Engagement RSE</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-white p-8 rounded-lg shadow-md mb-8">
                        <h3 class="text-2xl font-bold mb-4">Mon Engagement</h3>
                        <p class="text-gray-700 text-justify">
                            L'engagement citoyen et environnemental est quelque chose qui me tient particulièrement à cœur. J'ai déjà participé à plusieurs actions bénévoles et j'ai l'intention de continuer à m'investir dans des initiatives qui ont un impact positif sur la société et l'environnement.
                        </p>
                    </div>
                    
                    <div class="space-y-6">
                        {volunteering
                            .sort((a, b) => new Date(b.data.date || new Date().toISOString()).getTime() - new Date(a.data.date || new Date().toISOString()).getTime())
                            .map((vol) => (
                            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-purple-500">
                                <div class="flex flex-col md:flex-row gap-6">
                                    <div class="flex-shrink-0 flex justify-center items-center md:w-1/3">
                                        <Image src={vol.data.image} alt={vol.data.title} width={400} height={300} class="rounded shadow-md object-cover"/>
                                    </div>
                                    <div class="md:w-2/3 flex flex-col justify-center">
                                        <h4 class="text-2xl font-semibold mb-3">{vol.data.title}</h4>
                                        <p class="text-gray-700 text-justify text-lg">
                                            {vol.data.description}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>
        
        <section id="international" class="py-20 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">International</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-gray-50 p-8 rounded-lg shadow-md mb-8">
                        <h3 class="text-2xl font-bold mb-4">Mon projet international</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            Dans le cadre du cursus ingénieur à l'ENSEEIHT, je dois effectuer une expérience à l'étranger, ce qui m'intéresse particulièrement. Je souhaite partir dans un pays anglophone pour perfectionner mon anglais, découvrir de nouvelles approches pédagogiques et m'immerger dans une culture différente.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            Cette expérience internationale me permettra également d'élargir mon réseau professionnel et d'enrichir mon parcours académique avec des perspectives globales, tout en développant mon adaptabilité dans un environnement multiculturel.
                        </p>
                    </div>
                    
                    <div class="bg-white p-8 rounded-lg shadow-md mb-8 border-l-4 border-blue-500">
                        <h3 class="text-xl font-bold mb-4">Universités Ciblées</h3>
                        <p class="text-gray-700 mb-4">Je m'intéresse particulièrement aux trois universités suivantes pour leurs cours en informatique et en génie logiciel :</p>
                        <div class="space-y-4">
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold text-lg mb-2">🇨🇦 Concordia University - Canada</p>
                                <p class="text-sm text-gray-700"><strong>Spécialité :</strong> Computer Science and Software Engineering (CSSE)</p>
                                <p class="text-sm text-gray-600 mt-1">Programme reconnu pour sa forte orientation en génie logiciel et développement d'applications.</p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold text-lg mb-2">🇳🇴 Norges Teknisk-Naturvitenskapelige Universitet (NTNU) - Norvège</p>
                                <p class="text-sm text-gray-700"><strong>Département :</strong> Department of Computer Science (IDI)</p>
                                <p class="text-sm text-gray-600 mt-1">L'une des meilleures universités techniques de Scandinavie, réputée pour ses programmes en informatique.</p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold text-lg mb-2">🇦🇺 University of Sydney - Australie</p>
                                <p class="text-sm text-gray-700"><strong>Major :</strong> Computer Science</p>
                                <p class="text-sm text-gray-600 mt-1">Programme axé sur le software engineering avec une approche pratique et innovante.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-green-50 p-6 rounded-lg shadow-md border-l-4 border-green-500">
                        <h4 class="text-lg font-semibold mb-3">Opportunité via Sopra Steria</h4>
                        <p class="text-gray-700 text-justify">
                            En tant qu'alternant chez Sopra Steria, j'ai l'opportunité de partir à l'étranger avec mon entreprise. Voici un résumé des informations communiquées (pour des raisons de confidentialité) :
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mt-3 space-y-2">
                            <li><strong>Espagne :</strong> En gardant la même mission qu'actuellement, il est très facile de rejoindre l'équipe espagnole qui travaille sur le même projet.</li>
                            <li><strong>Autres pays anglophones :</strong> C'est possible, mais cela dépend des disponibilités, des places et des besoins de l'entreprise au moment de la demande.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section id="projects" class="py-20">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Mes Projets</h2>
                <p class="text-center text-lg mb-8">Voici quelques projets sur lesquels j'ai travaillé sur mon temps libre, ou lors de projets durant mes formations.</p>
                <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                    {projects
                        // .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
                        .map((project) => (
                            <ProjectCard 
                                title={project.data.titre} 
                                description={project.data.description} 
                                link={"/portfolio-website/"+lang+"/project/" + project.id.split('/')[1].replace('.mdx', '')}
                                technologies={project.data.technologies}
                                tags={project.data.tags}
                            />
                    ))}
                </div>
            </div>
        </section>
    </main>
	<Footer />
	
	<script>
		// Script pour la section protégée par mot de passe
		const passwordInput = document.getElementById('password-input') as HTMLInputElement;
		const unlockBtn = document.getElementById('unlock-btn') as HTMLButtonElement;
		const errorMsg = document.getElementById('error-msg') as HTMLElement;
		const protectedSection = document.getElementById('protected-section') as HTMLElement;
		const protectedContent = document.getElementById('protected-content') as HTMLElement;
		
		// Mot de passe simple - À changer selon vos besoins
		const correctPassword = 'cam2025';
		
		unlockBtn?.addEventListener('click', () => {
			if (passwordInput?.value === correctPassword) {
				protectedSection?.classList.add('hidden');
				protectedContent?.classList.remove('hidden');
				errorMsg?.classList.add('hidden');
			} else {
				errorMsg?.classList.remove('hidden');
			}
		});
		
		passwordInput?.addEventListener('keypress', (e) => {
			if (e.key === 'Enter') {
				unlockBtn?.click();
			}
		});
	</script>
</body>
</html>