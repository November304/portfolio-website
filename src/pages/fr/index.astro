---
import "../../styles/global.css";
import Header from '../../components/Header.astro';
import Footer from "../../components/Footer.astro";

import cityImage from '../../assets/img/city.jpg';
import imagePP from '../../assets/img/mecrandom.jpg';
import { Image } from 'astro:assets';

import { getCollection } from "astro:content";
import { getLangFromUrl } from "../../i18n/utils"
import ProjectCard from "../../components/generic/ProjectCard.astro";

const lang = getLangFromUrl(Astro.url);
const formations = await getCollection("formations", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});
const experiences = await getCollection("experiences", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});

const volunteering = await getCollection("volunteering", (entry) => {
  return entry.id.startsWith(`${lang}/`);
});

const projects = await getCollection("blog", (entry) => {
  return entry.data.lang == lang;
});


---
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Site Portfolio</title>
</head>
<body class="bg-white text-gray-900">
    <Header />
    
    <main>
        
        <section id="home" class="min-h-screen flex flex-col items-center justify-center pt-20 relative">
            <div class="text-center flex-1 flex flex-col justify-center">
                <h1 class="text-5xl font-bold mb-4">Nathan Pagnucco</h1>
                <p class="text-xl text-gray-600">Développeur | DevOps | Game Dev</p>
                <div class="absolute inset-0 z-[-1]">
                    <Image src={cityImage} alt="City background" class="w-full h-full object-cover opacity-20" loading="eager"/>
                </div>
                <div class="mt-8">
                    <a href="#projects" class="bg-blue-500 text-white px-6 py-3 rounded-full hover:bg-blue-600 transition">
                        Découvrir mes Projets
                    </a>
                </div>
            </div>
            <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
                <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </div>
        </section>

        <section id="home" class="bg-gray-100 py-20">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Accueil</h2>
                <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8">
                    <div class="flex flex-col items-center">
                        <Image 
                            src={imagePP} 
                            alt="Profil de Nathan Pagnucco" 
                            class="rounded-lg shadow-md w-48 h-auto sm:w-64 md:w-72"
                        />
                        <p class="mt-4 font-semibold">Email :</p>
                        <a 
                            href="mailto:nathan.pagnucco@gmail.com" 
                            class="text-blue-500 hover:underline"
                        >
                            nathan.pagnucco@gmail.com
                        </a>
                        <a 
                            href="/portfolio-website/CVNP-fr.pdf" 
                            download 
                            class="mt-2 px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
                        >
                            Télécharger mon CV
                        </a>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold mb-4">Pourquoi moi ?</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            Actuellement en première année de cycle ingénieur à l'ENSEEIHT en alternance à Sopra Steria, je me spécialise dans le développement logiciel. Ce parcours en alternance me permet de combiner théorie académique et pratique professionnelle, notamment à travers des missions d'optimisation et de maintenance de code.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            Passionné par le développement de jeux vidéo, je développe régulièrement des prototypes et des mécaniques de jeu avec Unity. J'aime particulièrement concevoir des environnements 2D ou 3D interactifs, travailler sur l'optimisation des performances et relever les défis créatifs du game design.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            Mon engagement dans la vie associative et mon intérêt pour les dimensions internationales et sociétales du métier d'ingénieur me permettent d'avoir une vision complète et responsable de mon futur rôle professionnel.
                        </p>
                    </div>
                </div>
                
                <!-- Section protégée par mot de passe -->
                <div class="mt-12 max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-md">
                    <h3 class="text-2xl font-bold mb-4 text-center">Espace Protégé</h3>
                    <div id="protected-section" class="text-center">
                        <p class="text-gray-600 mb-4">Cette section contient l'elevator pitch et les interviews. Veuillez entrer le mot de passe pour y accéder.</p>
                        <input 
                            type="password" 
                            id="password-input" 
                            placeholder="Mot de passe"
                            class="px-4 py-2 border border-gray-300 rounded mb-4 w-64"
                        />
                        <button 
                            id="unlock-btn"
                            class="px-6 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 ml-2"
                        >
                            Déverrouiller
                        </button>
                        <p id="error-msg" class="text-red-500 mt-2 hidden">Mot de passe incorrect</p>
                    </div>
                    <div id="protected-content" class="hidden">
                        <div class="mb-6">
                            <h4 class="text-xl font-semibold mb-3">Elevator Pitch</h4>
                            <p class="text-gray-700 text-justify">
                                [Votre elevator pitch ici - à personnaliser]
                            </p>
                        </div>
                        <div>
                            <h4 class="text-xl font-semibold mb-3">Interviews</h4>
                            <p class="text-gray-700 text-justify">
                                [Vos interviews ici - à personnaliser]
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section id="engineering" class="py-20 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Parcours Ingénieur</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-gray-50 p-8 rounded-lg shadow-md">
                        <h3 class="text-2xl font-bold mb-4">ENSEEIHT - Sciences du Numérique</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            Je suis actuellement étudiant en cycle ingénieur à l'ENSEEIHT (École Nationale Supérieure d'Électrotechnique, d'Électronique, d'Informatique, d'Hydraulique et des Télécommunications) en Sciences du Numérique. Cette formation d'excellence me permet d'approfondir mes compétences dans deux domaines complémentaires :
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mb-4 space-y-2">
                            <li><strong>Réseaux et Télécommunications :</strong> J'étudie l'architecture des réseaux, les protocoles de communication, la sécurité des systèmes distribués et les infrastructures de télécommunications modernes.</li>
                            <li><strong>Développement logiciel :</strong> Je me forme aux méthodologies de développement, à l'architecture logicielle, aux bases de données, à l'intelligence artificielle et aux technologies web et mobile.</li>
                        </ul>
                        
                        <h4 class="text-xl font-semibold mb-3 mt-6">Engagement Associatif</h4>
                        <p class="text-gray-700 mb-4 text-justify">
                            Au-delà de mes études, je m'investis activement dans la vie associative de l'école, notamment au sein de <strong>net7</strong>, l'association informatique de l'ENSEEIHT. En tant que <strong>Vice-président</strong>, je coordonne plusieurs activités :
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mb-4 space-y-2">
                            <li><strong>Développement de jeux vidéo :</strong> Organisation de game jams et création de prototypes ludiques avec l'équipe.</li>
                            <li><strong>Développement web :</strong> Conception et maintenance de sites web pour l'association et l'école.</li>
                            <li><strong>Gestion informatique :</strong> Administration des systèmes, support technique et gestion de l'infrastructure de l'association.</li>
                        </ul>
                        <p class="text-gray-700 text-justify">
                            Ces responsabilités me permettent de développer mes compétences en gestion de projet, en travail d'équipe et en leadership, tout en contribuant activement à la communauté étudiante.
                        </p>
                    </div>
                    
                    <div class="mt-8 grid md:grid-cols-2 gap-6">
                        <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-500">
                            <h4 class="text-xl font-semibold mb-3">Expériences Professionnelles</h4>
                            <div class="space-y-4">
                                {experiences
                                    .sort((a, b) => new Date(b.data.period.split(" - ")[1] || new Date().toISOString()).getTime() - new Date(a.data.period.split(" - ")[1] || new Date().toISOString()).getTime())
                                    .map((exp) => (
                                    <div>
                                        <p class="font-semibold">{exp.data.title}</p>
                                        <p class="text-sm text-gray-600">{exp.data.company} | {exp.data.period}</p>
                                    </div>
                                ))}
                            </div>
                        </div>
                        
                        <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-green-500">
                            <h4 class="text-xl font-semibold mb-3">Formations</h4>
                            <div class="space-y-4">
                                {formations
                                    .sort((a, b) => new Date(b.data.period.split(" - ")[1] || new Date().toISOString()).getTime() - new Date(a.data.period.split(" - ")[1] || new Date().toISOString()).getTime())
                                    .map((formation) => (
                                    <div>
                                        <p class="font-semibold">{formation.data.title}</p>
                                        <p class="text-sm text-gray-600">{formation.data.school} | {formation.data.period}</p>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section id="csr" class="py-20 bg-gray-50">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Engagement RSE</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-white p-8 rounded-lg shadow-md mb-8">
                        <h3 class="text-2xl font-bold mb-4">Pourquoi la Responsabilité Sociétale des Entreprises ?</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            La Responsabilité Sociétale des Entreprises (RSE) représente pour moi bien plus qu'un simple concept : c'est une conviction profonde que les ingénieurs de demain doivent intégrer les enjeux environnementaux et sociétaux dans leur pratique professionnelle.
                        </p>
                        <p class="text-gray-700 mb-4 text-justify">
                            Dans un monde confronté aux défis du changement climatique, de l'inclusivité et de l'équité sociale, je crois fermement que notre génération d'ingénieurs a la responsabilité de concevoir des solutions technologiques durables et éthiques. C'est pourquoi je m'engage activement dans des initiatives qui ont un impact positif sur la société et l'environnement.
                        </p>
                        <p class="text-gray-700 text-justify">
                            Mon engagement RSE se concrétise à travers des actions bénévoles qui me permettent de contribuer directement à des causes qui me tiennent à cœur, tout en développant une conscience citoyenne essentielle à ma future carrière d'ingénieur.
                        </p>
                    </div>
                    
                    <div class="space-y-6">
                        {volunteering
                            .sort((a, b) => new Date(b.data.date || new Date().toISOString()).getTime() - new Date(a.data.date || new Date().toISOString()).getTime())
                            .map((vol) => (
                            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-purple-500">
                                <div class="flex flex-col md:flex-row gap-6">
                                    <div class="flex-shrink-0 flex justify-center items-center md:w-1/3">
                                        <Image src={vol.data.image} alt={vol.data.title} width={400} height={300} class="rounded shadow-md object-cover"/>
                                    </div>
                                    <div class="md:w-2/3 flex flex-col justify-center">
                                        <h4 class="text-2xl font-semibold mb-3">{vol.data.title}</h4>
                                        <p class="text-gray-700 text-justify text-lg">
                                            {vol.data.description}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>
        
        <section id="international" class="py-20 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">International</h2>
                <div class="max-w-4xl mx-auto">
                    <div class="bg-gray-50 p-8 rounded-lg shadow-md mb-8">
                        <h3 class="text-2xl font-bold mb-4">Un Projet International</h3>
                        <p class="text-gray-700 mb-4 text-justify">
                            L'ouverture internationale fait partie intégrante du cursus d'ingénieur à l'ENSEEIHT. Dans le cadre de mon diplôme, je suis amené à réaliser une expérience à l'étranger, une opportunité qui m'intéresse particulièrement pour plusieurs raisons :
                        </p>
                        <ul class="list-disc list-inside text-gray-700 mb-4 space-y-2">
                            <li>Découvrir de nouvelles approches pédagogiques et méthodologies de travail</li>
                            <li>Perfectionner mes compétences linguistiques en anglais</li>
                            <li>M'immerger dans une culture différente et développer mon adaptabilité</li>
                            <li>Élargir mon réseau professionnel à l'international</li>
                            <li>Enrichir mon parcours académique avec des perspectives globales</li>
                        </ul>
                    </div>
                    
                    <div class="bg-white p-8 rounded-lg shadow-md mb-8 border-l-4 border-blue-500">
                        <h3 class="text-xl font-bold mb-4">Universités Anglophones Ciblées</h3>
                        <p class="text-gray-700 mb-4">Je m'intéresse particulièrement aux universités suivantes pour leur excellence académique en informatique et leurs programmes en sciences du numérique :</p>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold">🇬🇧 Royaume-Uni</p>
                                <ul class="text-sm text-gray-700 mt-2 space-y-1">
                                    <li>• University of Edinburgh</li>
                                    <li>• Imperial College London</li>
                                    <li>• University College London (UCL)</li>
                                </ul>
                            </div>
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold">🇨🇦 Canada</p>
                                <ul class="text-sm text-gray-700 mt-2 space-y-1">
                                    <li>• University of Toronto</li>
                                    <li>• McGill University</li>
                                    <li>• University of British Columbia</li>
                                </ul>
                            </div>
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold">🇦🇺 Australie</p>
                                <ul class="text-sm text-gray-700 mt-2 space-y-1">
                                    <li>• Australian National University</li>
                                    <li>• University of Melbourne</li>
                                </ul>
                            </div>
                            <div class="bg-gray-50 p-4 rounded">
                                <p class="font-semibold">🇸🇪 Suède</p>
                                <ul class="text-sm text-gray-700 mt-2 space-y-1">
                                    <li>• KTH Royal Institute of Technology</li>
                                    <li>• Chalmers University</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-green-50 p-6 rounded-lg shadow-md border-l-4 border-green-500">
                        <h4 class="text-lg font-semibold mb-3">✓ Confirmation de Faisabilité</h4>
                        <p class="text-gray-700 text-justify italic">
                            "Selon les informations fournies par le service des ressources humaines de l'école, ce projet international est tout à fait réalisable dans le cadre de mon cursus en alternance. Des cas similaires ont déjà été gérés avec succès, et l'école dispose des mécanismes nécessaires pour accompagner les étudiants dans ce type de mobilité internationale."
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="projects" class="py-20">
            <div class="container mx-auto px-4">
                <h2 class="text-4xl font-bold text-center mb-12">Mes Projets</h2>
                <p class="text-center text-lg mb-8">Voici quelques projets sur lesquels j'ai travaillé sur mon temps libre, ou lors de projets durant mes formations.</p>
                <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                    {projects
                        // .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
                        .map((project) => (
                            <ProjectCard 
                                title={project.data.titre} 
                                description={project.data.description} 
                                link={"/portfolio-website/"+lang+"/project/" + project.id.split('/')[1].replace('.mdx', '')}
                                technologies={project.data.technologies}
                                tags={project.data.tags}
                            />
                    ))}
                </div>
            </div>
        </section>
    </main>
	<Footer />
	
	<script>
		// Script pour la section protégée par mot de passe
		const passwordInput = document.getElementById('password-input') as HTMLInputElement;
		const unlockBtn = document.getElementById('unlock-btn') as HTMLButtonElement;
		const errorMsg = document.getElementById('error-msg') as HTMLElement;
		const protectedSection = document.getElementById('protected-section') as HTMLElement;
		const protectedContent = document.getElementById('protected-content') as HTMLElement;
		
		// Mot de passe simple - À changer selon vos besoins
		const correctPassword = 'portfolio2024';
		
		unlockBtn?.addEventListener('click', () => {
			if (passwordInput?.value === correctPassword) {
				protectedSection?.classList.add('hidden');
				protectedContent?.classList.remove('hidden');
				errorMsg?.classList.add('hidden');
			} else {
				errorMsg?.classList.remove('hidden');
			}
		});
		
		passwordInput?.addEventListener('keypress', (e) => {
			if (e.key === 'Enter') {
				unlockBtn?.click();
			}
		});
	</script>
</body>
</html>